{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "primary", "name": "Primary", "color": "#111827" },
        { "slug": "secondary", "name": "Secondary", "color": "#475569" },
        { "slug": "accent", "name": "Accent", "color": "#b7791f" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "muted", "name": "Muted", "color": "#f8fafc" },
        { "slug": "border", "name": "Border", "color": "#e2e8f0" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.5rem" },
        { "slug": "20", "name": "S", "size": "0.75rem" },
        { "slug": "30", "name": "M", "size": "1rem" },
        { "slug": "40", "name": "L", "size": "1.5rem" },
        { "slug": "50", "name": "XL", "size": "2rem" },
        { "slug": "60", "name": "2XL", "size": "clamp(2.5rem, 5vw, 5rem)" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
        { "slug": "x-large", "name": "X Large", "size": "clamp(1.75rem, 4vw, 3rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(2.25rem, 6vw, 5rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--primary)"
    },
    "typography": {
      "fontFamily": "var(--itk-font-body, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
      },
      "button": {
        "border": { "radius": "0.75rem" },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--surface)"
        },
        "spacing": {
          "padding": { "top": "0.8rem", "right": "1.2rem", "bottom": "0.8rem", "left": "1.2rem" }
        }
      }
    }
  }
}
